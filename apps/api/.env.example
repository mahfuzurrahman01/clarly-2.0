# Copy to .env for local dev. See docs/decisions/F0-infra.md for the
# production values (Supabase Supavisor URI, Upstash/Railway Redis URI) and
# secrets layout across Railway/Vercel/Supabase.

NODE_ENV=development
PORT=4000

# Skips Swagger/OpenAPI setup at boot (dev only — /docs is already off under
# NODE_ENV=production). Only the exact string `true` skips it; anything else,
# including `false`, leaves the docs page on. Handy when boot time matters
# while debugging, since building the document walks every controller.
# SKIP_SWAGGER=true

# Comma-separated browser origins allowed to call this API (apps/web).
# Empty disables CORS. Set to the Vercel origin in production.
CORS_ORIGINS=http://localhost:3000

# Local dev: docker-compose Postgres. Connects as `app_user`, NOT the
# bootstrap `postgres` superuser — see docs/decisions/F1-security.md. RLS
# (Feature 1's T5) is silently bypassed for superusers/BYPASSRLS roles
# regardless of policy, so this is a correctness requirement, not style.
# `app_user` is created by docker-entrypoint-initdb.d/01-app-role.sql.
# Prod: Supabase Supavisor transaction-mode pooler URI, port 6543 — verify
# the connecting Supabase role is non-superuser/non-BYPASSRLS there too.
DATABASE_URL=postgres://app_user:app_password@localhost:5432/whatsapp_ai_agent

# Local dev: docker-compose Redis.
# Prod: Upstash Redis (pending cost/compat sign-off, see F0-infra.md) or the
# Railway-hosted Redis fallback.
REDIS_URL=redis://localhost:6379

# Queue polling profile: `default` | `lean`. Default `default` (stock BullMQ).
# `lean` is for metered or small free Redis tiers (Upstash free = 500K
# commands/month): idle workers block up to 5 min instead of 5-10s and check
# for stalled jobs every 5 min instead of 30s, and the sub-hourly sweeps
# default to longer intervals (alerting checks 5 min, auto-close and
# shipment poll 30 min, store sync 1 h). Any *_INTERVAL_MS you set below
# still wins. New jobs are picked up immediately in both profiles; lean only
# slows crash recovery of in-flight jobs (up to ~10 min) and recovery from a
# silently dropped Redis connection (up to ~5 min). Lean does NOT reduce the
# connection count (one blocking connection per worker, 26 total).
# Unknown values fail startup.
# QUEUE_PROFILE=default

# AuthModule (Feature 1). Supabase project settings -> API -> JWT Secret in
# prod. Verifies the HS256-signed Supabase Auth JWT and reads the tenant_id
# claim from app_metadata — see docs/decisions/F1-security.md.
SUPABASE_JWT_SECRET=local-dev-jwt-secret-change-me

# WhatsappModule (Feature 2). AES-256-GCM key encrypting per-tenant BSP
# credentials at rest — must be base64 decoding to exactly 32 bytes.
# Generate a real one with: openssl rand -base64 32
# See docs/decisions/F2-channel.md.
BSP_CREDENTIALS_ENCRYPTION_KEY=GYWND/auzYNVrrsIqm1l2GO2dNXphb3Nt/9HWRLPCzQ=

# WhatsappModule (T0). Which BspAdapter binding is active. 'none' (default)
# binds a real fail-closed no-op, so the app boots with no Meta app; it is
# refused when NODE_ENV=production.
#
#   meta — Meta Cloud API direct, the ONLY WhatsApp provider (D14, Gulf T2:
#     360dialog was removed, no fallback). Tenants connect their own WABA via
#     our Meta app's Embedded Signup (T3).
#
# BSP_PROVIDER=none
# META_GRAPH_BASE_URL=https://graph.facebook.com
# META_GRAPH_VERSION=v21.0
#
# ONE app secret + verify token pair for ALL Meta traffic (D8): WhatsApp
# Cloud API and the Messenger/Instagram social channels
# (META_SOCIAL_CHANNELS_ENABLED) alike. Required when BSP_PROVIDER=meta or
# META_SOCIAL_CHANNELS_ENABLED=true.
# DEPRECATED: META_SOCIAL_APP_SECRET / META_SOCIAL_VERIFY_TOKEN are still
# accepted for one release, only when the pair below is unset, and log a
# startup warning. Rename them to META_APP_SECRET / META_VERIFY_TOKEN.
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# The Meta app id. Required when BSP_PROVIDER=meta (Gulf T3: the Embedded
# Signup code exchange's client_id) or META_SOCIAL_CHANNELS_ENABLED=true.
# Since T3, BSP_PROVIDER=meta also requires META_APP_SECRET even with the
# dev-only signature bypass below. The Embedded Signup configuration id is a
# web-only value: NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID (apps/web).
# META_APP_ID=
# BSP_REQUEST_TIMEOUT_MS=10000
#
# Signs the tenant-bound CSRF state for the WhatsApp connect flow
# (ConnectStateService). Generate with: openssl rand -base64 32
# WHATSAPP_CONNECT_STATE_SECRET=
#
# This API's own publicly reachable base URL (absolute, no trailing slash).
# Every URL we hand a third party that must point back at us is built from
# it, so leaving it unset now DISABLES features rather than degrading them:
#   - the Meta data-deletion status URL (privacy/)
#   - product image upload (POST /catalog/products/:id/image), which stores
#     an absolute image_url and 503s without one
#   - the WooCommerce connect flow, whose callback_url is posted to the
#     merchant's own WordPress site and 503s without one
# (SALLA_REDIRECT_URI / ZID_REDIRECT_URI / WOOCOMMERCE_CALLBACK_URL below
# each override their own derived value if you set them explicitly.)
# API_PUBLIC_BASE_URL=https://api.example.com
#
# DANGEROUS, DEV-ONLY. 'false' makes the bound adapter accept ANY inbound
# webhook without verifying its signature — POST /webhooks/whatsapp becomes
# unauthenticated. Only for local replay of captured payloads; envSchema makes
# NODE_ENV=production + 'false' a STARTUP FAILURE. Meta always signs, so
# never set this against real traffic.
# BSP_WEBHOOK_SIGNATURE_REQUIRED=true

# KnowledgeBaseModule (Feature 2.5). 'local' (default) writes to
# KB_LOCAL_STORAGE_DIR (relative to apps/api/, gitignored); 'supabase' is
# the production binding and needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# plus a PRIVATE bucket (see docs/HANDOFF.md for the one-time bucket
# creation). See docs/decisions/F2.5-kb-foundation.md.
# KB_STORAGE_PROVIDER=local
# KB_LOCAL_STORAGE_DIR=.data/kb-uploads
# KB_STORAGE_BUCKET=kb-documents

# LlmModule (Feature 3, A0/D1). Defaults to 'qwen': a self-hosted vLLM server
# exposing the OpenAI-compatible /v1/chat/completions surface, with tool
# calling enabled (--enable-auto-tool-choice). Preferred over 'gemini' because
# GEMINI_API_KEY is one shared, rate-limited quota — the 2026-08-15 eval
# baseline failed 14 of 17 cases on 429s while recall@5 was 100%.
#
# LLM_BASE_URL and LLM_MODEL default to Gemini's values, so BOTH must be set
# when LLM_PROVIDER=qwen — the schema rejects the Gemini defaults in that case
# rather than let every turn 404. Check GET <LLM_BASE_URL>/models for the
# served model id; this host does not pin its model.
# There is no key to set: the vLLM endpoint is unauthenticated.
LLM_PROVIDER=qwen
LLM_BASE_URL=https://llm.arahim.dev/v1
LLM_MODEL=qwen3.6-35b-a3b
#
# Rollback path (D1) — GeminiProvider stays bound and selectable. Get a key
# from https://aistudio.google.com/apikey. See docs/decisions/F3-agent-core.md.
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash-lite
#
# D9 (launch security): in production the vLLM box above sits behind a
# Cloudflare Access application (service-token auth), not the open internet —
# "unauthenticated" above describes the vLLM API itself, not the tunnel in
# front of it. Both are REQUIRED when NODE_ENV=production and
# LLM_PROVIDER=qwen or EMBEDDING_PROVIDER=qwen (env.schema.ts's refine());
# optional in dev/CI running the box on an open LAN. Generate a service token
# in the Cloudflare Zero Trust dashboard -> Access -> Service Auth.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
#
# ---------------------------------------------------------------------------
# Feature 17 (A11/A12) — image and voice understanding.
#
# Separate from LLM_PROVIDER on purpose: the default chat binding above is a
# self-hosted TEXT-ONLY model, so vision and ASR cannot ride on it. Both run on
# Gemini's multimodal endpoint with the same GEMINI_API_KEY below.
#
# Set either to 'none' to get the pre-Feature-17 behaviour for that modality:
# the customer's image / voice note escalates as UNSUPPORTED_MEDIA to a human
# instead of being answered. Nothing is silently dropped in either setting.
VISION_PROVIDER=gemini
VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VISION_MODEL=gemini-3.5-flash
ASR_PROVIDER=gemini
ASR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ASR_MODEL=gemini-3.5-flash
# Or any server speaking OpenAI's POST /audio/transcriptions (self-hosted
# Whisper / Audar-ASR, Groq). ASR_API_KEY is optional: empty sends no
# Authorization header.
# ASR_PROVIDER=openai-compatible
# ASR_BASE_URL=https://asr.arahim.dev/v1
# ASR_MODEL=audarai/Audar-ASR-V1-Turbo
# ASR_API_KEY=
# Largest attachment handed to a multimodal model in ONE turn. Distinct from
# INBOUND_MEDIA_MAX_BYTES (what we are willing to STORE for a human to look
# at) — over this, the turn escalates rather than blowing the loop deadline.
MEDIA_UNDERSTANDING_MAX_BYTES=8388608
#
# Per-call deadline. The vLLM box cold-starts: the first request after an idle
# period has been measured at >30s, while warm calls are sub-2s. A cold start
# therefore blows the 10s default and counts toward the D2 breaker — raise
# this, or warm the box, if cold starts are common in your environment.
# LLM_REQUEST_TIMEOUT_MS=10000
# LLM_BREAKER_FAILURE_THRESHOLD=5
# LLM_BREAKER_RESET_MS=30000
GEMINI_API_KEY=

# Embedder port (D5). Defaults to 'qwen': a self-hosted vLLM server exposing
# the OpenAI-compatible /v1/embeddings surface. Preferred over 'gemini'
# because the Gemini embedder shares GEMINI_API_KEY with the chat provider,
# so a KB ingest burst and live chat traffic contend for one rate limit and a
# 429 fails the turn. The vLLM box has no per-minute cap.
#
# EMBEDDING_BASE_URL is REQUIRED when EMBEDDING_PROVIDER=qwen. The original
# vLLM box was unauthenticated, but 'qwen' also covers any other
# OpenAI-compatible self-hosted embedding host; if that host requires a
# bearer token, set EMBEDDING_API_KEY (sent as Authorization Bearer header).
# EMBEDDING_MODEL must name a model the server actually serves — check
# GET <base-url>/v1/models.
EMBEDDING_BASE_URL=https://embedd.arahim.dev
# EMBEDDING_API_KEY is unset here
# EMBEDDING_PROVIDER=qwen
#
# PINNED to the concrete model id, never the floating `qwen-embed` alias. Both
# Qwen3-Embedding-4B (2560-dim) and 0.6B (1024-dim) answered to that alias on
# the shared host, so it swapped the vector space under us without a config
# change. Check GET <base-url>/v1/models before changing this.
# EMBEDDING_MODEL=qwen3-embedding-0.6b
#
# EMBEDDING_DIMENSIONS must equal kb_chunks.embedding's width and is validated
# as exactly 1024 at boot. Changing it means a new migration AND a full
# re-embed, never just an env edit. Qwen3-Embedding-0.6B (what this host
# currently serves) emits 1024 natively and cannot truncate (no Matryoshka
# support); Gemini matches it via outputDimensionality, which is what lets one
# schema serve both adapters.
# EMBEDDING_DIMENSIONS=1024
#
# The served model's context ceiling, sent as truncate_prompt_tokens so an
# over-long chunk clips instead of failing the whole batch with a 400.
# EMBEDDING_MAX_INPUT_TOKENS=4096
#
# Rollback to Gemini: set EMBEDDING_PROVIDER=gemini and
# EMBEDDING_MODEL=gemini-embedding-001, then re-run `pnpm --filter api
# db:reembed -- --all`. Vectors from the two providers are NOT comparable, so
# the re-embed is mandatory, not optional.

# RetrievalModule (Feature 3, A1). Reranking is optional — 'none' (default)
# binds a real no-op adapter; RRF-fused hybrid search already produces a
# usable ranking without it. Cohere is the decided vendor (D4) once a
# Cohere account exists — set RERANK_PROVIDER=cohere and COHERE_API_KEY
# together, never one without the other (envSchema enforces this).
# RERANK_PROVIDER=none
# COHERE_API_KEY=
# Hard cap on one rerank call, in ms. Past it the query is served in its
# RRF-fused order (the rerank-disabled ranking) and the fallback is logged at
# ERROR. Cohere is ~0.4s at p50 but stalls ~10.5s on a few percent of calls.
# RERANK_TIMEOUT_MS=2000

# AlertingModule (Feature 5, T4). How often the stuck-ticket sweep runs,
# not the per-tenant threshold (that's tenant_policy.stuck_ticket_threshold_minutes).
# STUCK_TICKET_CHECK_INTERVAL_MS=60000

# OnboardingModule (Feature 6). 'none' (default) binds a real no-op
# adapter that logs what it would have done — no Supabase project
# provisioned in this environment. Set TENANT_PROVISIONING_PROVIDER=supabase
# and both vars below together (a real service-role key, never a
# placeholder) once one exists.
# TENANT_PROVISIONING_PROVIDER=none
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# AlertingModule (Feature 7, T9). p95 respond-path latency budget/window/sweep interval.
# LATENCY_P95_BUDGET_MS=5000
# LATENCY_CHECK_WINDOW_MINUTES=15
# LATENCY_CHECK_INTERVAL_MS=60000

# OutcomesModule (Feature 7, A9). Never-escalated conversation auto-close heuristic.
# AUTO_CLOSE_INACTIVITY_HOURS=24
# AUTO_CLOSE_CHECK_INTERVAL_MS=300000

# Launch billing backend (Lane A). Trial lifecycle emails.
# TRIAL_EMAIL_CHECK_INTERVAL_MS=86400000
# TRIAL_ENDING_SOON_DAYS=3

# RetentionModule (Feature 7, T16). 90-day raw-transcript purge.
# TRANSCRIPT_RETENTION_DAYS=90
# PURGE_CHECK_INTERVAL_MS=86400000

# BillingModule (Feature 8, T19). Stripe confirmed as the payment provider
# (2026-08-13). 'none' (default) binds a real no-op adapter that logs what
# it would have done — no Stripe account configured in this environment.
# Set BILLING_PROVIDER=stripe and both vars below together (real
# credentials, never placeholders) once a Stripe account exists.
# BILLING_PROVIDER=none
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# AgentModule / GuardrailModule (A6, 2026-08-17). Output-side grounding check:
# one small extra LLM call per answered turn that cited at least one passage,
# verifying the cited passages actually cover the question before the answer is
# sent. Default 'true' — it closes the two missed-escalation cases that survived
# every prompt attempt (docs/decisions/A0-production-readiness-plan.md P0.4).
# Set 'false' only as a latency/cost escape hatch, knowing those cases come back.
# AGENT_GROUNDING_CHECK_ENABLED=true

# EmailModule (gap #3, 2026-08-20). Mail the product itself originates —
# today, critical alerts (an escalated ticket nobody has picked up).
#
# NOT the channel for password reset, email verification or team invites:
# those are Supabase Auth's own flows and go out through the Supabase
# project's SMTP settings. Supabase's built-in SMTP is rate-limited and not
# for production, so a real deployment must configure custom SMTP there
# regardless of what is set here.
#
# 'none' (default) binds a fail-closed no-op: it reports itself disabled so
# alerts skip mailing, and throws if anything sends through it anyway.
# EMAIL_PROVIDER=none
# RESEND_API_KEY=
# A verified sender on the Resend domain. Bare address or `Name <address>`.
# EMAIL_FROM_ADDRESS=
# Where the console lives, so an alert email can link to the thing it is
# about. Without it the mail still says what happened, minus the link.
# CONSOLE_BASE_URL=

# ObservabilityModule (Launch Plan item 7). Sentry on the API/worker process.
# Unset (default) is a real no-op: instrument.ts skips Sentry.init()
# entirely rather than call it with an empty DSN.
# SENTRY_DSN=
# Defaults to NODE_ENV when unset.
# SENTRY_ENVIRONMENT=
# Fraction of transactions traced (0..1).
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Where PlatformHealthPagingSubscriber pages a human for a platform-level
# alert (circuit breaker open, DLQ depth, DB/Redis unreachable) — distinct
# from EMAIL_PROVIDER above, which (via AlertEmailService) mails a TENANT's
# admins about a tenant-scoped alert. Unset means Sentry, if configured, is
# the only paging channel.
# PLATFORM_ALERT_EMAIL=

# StoreModule (F24, Gulf Parity Phase 6). OAuth app credentials for the
# e-commerce platforms a merchant can connect their store from.
#
# There is deliberately no single STORE_PROVIDER switch: the provider is
# per-tenant (`store_connections.provider`), so one deployment serves a Salla
# merchant and a Zid merchant at once. Configure the pairs you have an app
# for; a connect attempt for a provider whose pair is unset fails with a 503
# naming that provider, rather than redirecting the merchant with an empty
# client_id. Each id/secret pair must be set together or startup fails.
#
# Also required for any store to connect at all (both already above):
# WHATSAPP_CONNECT_STATE_SECRET (signs the tenant-bound OAuth state) and
# BSP_CREDENTIALS_ENCRYPTION_KEY (AES-256-GCM for the stored tokens).
# SALLA_CLIENT_ID=
# SALLA_CLIENT_SECRET=
# ZID_CLIENT_ID=
# ZID_CLIENT_SECRET=
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# Redirect URIs default to ${API_PUBLIC_BASE_URL}/store/callback/<provider>,
# which is the route the API actually serves. Set these only when the value
# registered in the provider's app console differs.
# SALLA_REDIRECT_URI=
# ZID_REDIRECT_URI=
# Fallback shop for Shopify's per-shop OAuth host; normally the shop arrives
# as `?shop=<name>.myshopify.com` on the connect call.
# SHOPIFY_SHOP_DOMAIN=
#
# WooCommerce has no client id/secret because it is not a hosted platform and
# has no OAuth server: each merchant's own WordPress site mints a permanent
# consumer key/secret through /wc-auth/v1/authorize and POSTs it to our
# callback. So WooCommerce needs no credentials here — but it DOES need an
# absolute callback URL to hand that site, so its connect flow 503s unless
# either WOOCOMMERCE_CALLBACK_URL or API_PUBLIC_BASE_URL is set. The two knobs
# the merchant sees on their own approval screen, and an override for the URL
# their site posts the new key pair to. There is deliberately no
# WOOCOMMERCE_SITE_URL — the merchant's site is per connection and is passed
# as `?siteUrl=` on the connect call, exactly like Shopify's `?shop=`.
# WOOCOMMERCE_APP_NAME=Clarly
# WOOCOMMERCE_CALLBACK_URL=
# How often the in-process sweep re-syncs products for every active
# connection. Default 15 minutes.
# STORE_SYNC_INTERVAL_MS=900000

# --- Clarly 2.0 S2: bookings + Google Calendar (BookingModule) ---------------
# Optional pair. Unset = "Connect Google Calendar" answers 503; bookings still
# work (as requests a person confirms, or instant without a calendar).
# Google Cloud console → APIs & Services: enable "Google Calendar API", create
# an OAuth client (type: Web application) and register the redirect URI
# `${API_PUBLIC_BASE_URL}/bookings/calendar/callback`. Scopes requested:
# calendar.events, calendar.freebusy, userinfo.email — the consent screen must
# be verified by Google before non-test users get refresh tokens that last.
# Also needs WHATSAPP_CONNECT_STATE_SECRET (signs the OAuth state),
# BSP_CREDENTIALS_ENCRYPTION_KEY (encrypts the refresh token) and
# CONSOLE_BASE_URL (where the callback sends the browser back to).
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=
