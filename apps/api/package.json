{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/integration/jest-integration.json",
    "test:meta-contract": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/meta-contract.json",
    "test:courier-contract": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/courier-contract.json",
    "test:store-contract": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/store-contract.json",
    "test:e2e:playwright": "playwright test",
    "eval:comment-intent": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns=comment-intent.eval --forceExit",
    "eval": "ts-node --files -r tsconfig-paths/register eval/runner.ts",
    "eval:golden-set": "ts-node --files -r tsconfig-paths/register eval/export-golden-set.ts",
    "eval:golden-set:diff": "ts-node --files -r tsconfig-paths/register eval/export-golden-set.ts --compare eval/golden-sets/latest.json",
    "db:seed": "ts-node --files -r tsconfig-paths/register scripts/seed-tenant.ts",
    "db:reembed": "ts-node --files -r tsconfig-paths/register scripts/reembed-chunks.ts",
    "comp-tenant": "ts-node --files -r tsconfig-paths/register scripts/comp-tenant.ts",
    "platform:grant": "ts-node --files -r tsconfig-paths/register scripts/platform-grant.ts",
    "routes:backfill": "ts-node --files -r tsconfig-paths/register scripts/routes-backfill.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.30",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@repo/errors": "workspace:*",
    "@sentry/nestjs": "^10.75.0",
    "@supabase/supabase-js": "^2.112.3",
    "bullmq": "^5.61.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.9.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.1",
    "nestjs-zod": "^5.5.0",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.5.0",
    "xlsx": "file:../../vendor/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.0.0",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "jszip": "^3.10.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/eval"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "eval/scoring.ts",
      "!**/*.module.ts",
      "!**/*.port.ts",
      "!**/*.d.ts",
      "!main.ts",
      "!app.module.ts",
      "!modules/index.ts",
      "!**/persistence.service.ts",
      "!**/persistence.providers.ts",
      "!**/tenant-context.service.ts",
      "!**/tenant-context.store.ts",
      "!**/drizzle/schema.ts",
      "!**/*.table.ts",
      "!**/drizzle/migrations/**",
      "!**/__fixtures__/**"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testEnvironment": "node"
  }
}
