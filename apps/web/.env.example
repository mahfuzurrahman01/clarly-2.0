# Clarly web console — copy to .env.local and fill in.

# Base URL of the NestJS API (apps/api). Local default:
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase project — the console authenticates users against the same project
# the API verifies JWTs from. Anon key is public/browser-safe by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (Launch Plan item 7). A DSN is not a secret (identifies a project,
# not an account) — NEXT_PUBLIC_ prefixing is the expected pattern, not an
# oversight. Unset (default) is a real no-op: every Sentry.init() call site
# in this app (instrumentation-client.ts, sentry.server.config.ts,
# sentry.edge.config.ts) skips init entirely rather than calling it with an
# empty DSN, and next.config.ts skips withSentryConfig's build-time
# source-map wrapping too.
# NEXT_PUBLIC_SENTRY_DSN=
# Defaults to NODE_ENV when unset.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Only needed alongside NEXT_PUBLIC_SENTRY_DSN, for build-time source-map
# upload (next.config.ts). Without a token the build still succeeds — it
# just doesn't upload maps (silent, not an error).
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Meta (one app for WhatsApp, Messenger, Instagram). Public by design.
# NEXT_PUBLIC_FACEBOOK_APP_ID is the same value as the API's META_APP_ID
# (FB.init appId). NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID is the
# Facebook Login for Business configuration created for WhatsApp Embedded
# Signup in the Meta App Dashboard (FB.login config_id; Gulf T3).
# NEXT_PUBLIC_FACEBOOK_LOGIN_CONFIG_ID is a second Facebook Login for
# Business configuration, token type "User access token", for connecting
# Facebook pages + Instagram (permissions: pages_show_list,
# pages_manage_metadata, pages_messaging, instagram_basic,
# instagram_manage_messages; Gulf T4). All optional: without the app id
# (or a flow's own config id) Settings -> Channels shows "not set up" and
# disables that connect button. Meta's popup needs an HTTPS origin listed
# in the app's Allowed domains.
# NEXT_PUBLIC_FACEBOOK_APP_ID=
# NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
# NEXT_PUBLIC_FACEBOOK_LOGIN_CONFIG_ID=
# Graph API version for FB.init; keep equal to the API's META_GRAPH_VERSION.
# NEXT_PUBLIC_META_GRAPH_VERSION=v21.0

# Dev-only webhook simulator (Playground → "simulate inbound message").
# Never enable in production; see app/api/dev-simulator/route.ts.
# DEV_SIMULATOR_ENABLED=true
# DEV_SIMULATOR_APP_SECRET=
# DEV_SIMULATOR_PHONE_NUMBER_ID=

# Cookie-consent banner (see components/shell/cookie-consent-banner.tsx).
# Turn on once analytics/EU-traffic tooling actually sets cookies that need
# consent — off by default.
# NEXT_PUBLIC_COOKIE_CONSENT_ENABLED=true

# Absolute site origin — used for SEO metadata (metadataBase, sitemap.xml,
# robots.txt, OG image URL). Defaults to localhost:3000; set this to the
# real production domain once one exists.
# NEXT_PUBLIC_SITE_URL=https://app.clarly.ai

# Web3Forms (https://web3forms.com) — landing-page waitlist form. Create an
# access key for the inbox that should receive signups. Public by design
# (the free plan only accepts browser-side submissions). Optional: unset
# hides the waitlist section on the landing page.
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
